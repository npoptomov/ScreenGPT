<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/responseDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_dim">

    <!-- Response Modal Window -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/brand_emerald" />

            <TextView
                android:id="@+id/tvResponseHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/response_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCloseResponse"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Response Content Scrollable View -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:maxHeight="380dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvResponseContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="14sp"
                tools:text="Here is the explanation of what is currently visible on your screen. The image shows a code editor with Kotlin files..." />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@color/glass_stroke" />

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyResponse"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_copy"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFollowUp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_button_gradient"
                android:text="@string/btn_follow_up"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_send"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
