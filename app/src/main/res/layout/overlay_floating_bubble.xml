<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- ScreenGPT Floating AI Bubble -->
    <ImageView
        android:id="@+id/ivBubbleIcon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_floating_bubble"
        android:contentDescription="ScreenGPT Bubble"
        android:elevation="10dp"
        android:padding="11dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_screen_gpt_bubble" />

</FrameLayout>
