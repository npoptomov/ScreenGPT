<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <!-- ChatGPT-style Floating Optical Squircle Emblem (64dp) -->
    <ImageView
        android:id="@+id/ivBubbleIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_floating_bubble"
        android:contentDescription="ScreenGPT Bubble"
        android:elevation="0dp"
        android:padding="2dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_screen_aperture_lens" />

</FrameLayout>
