<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/queryDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_dim">

    <!-- Query Card Centered / Bottom-Sheet Style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header with Title and Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/brand_emerald" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/query_dialog_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivCloseQuery"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_icon"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Preview Thumbnail + Prompt Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="80dp"
                app:cardBackgroundColor="@color/bg_input_dark"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivScreenshotThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@drawable/ic_capture" />
            </androidx.cardview.widget.CardView>

            <!-- Quick Chips Flow / Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="false">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipExplain"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prompt_explain"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_dark_elevated"
                        app:chipStrokeColor="@color/glass_stroke" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSummarize"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prompt_summarize"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_dark_elevated"
                        app:chipStrokeColor="@color/glass_stroke" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSolve"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prompt_solve"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_dark_elevated"
                        app:chipStrokeColor="@color/glass_stroke" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTranslate"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prompt_translate"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_dark_elevated"
                        app:chipStrokeColor="@color/glass_stroke" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipExtract"
                        style="@style/Widget.Material3.Chip.Suggestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prompt_extract"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/bg_dark_elevated"
                        app:chipStrokeColor="@color/glass_stroke" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Prompt Text Input & Send Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etQueryPrompt"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="@string/prompt_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnSubmitQuery"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_gradient"
                android:contentDescription="@string/btn_send"
                android:padding="12dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Loading Indicator -->
        <LinearLayout
            android:id="@+id/layoutQueryLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/brand_emerald" />

            <TextView
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/analyzing_screen"
                android:textColor="@color/brand_emerald"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
