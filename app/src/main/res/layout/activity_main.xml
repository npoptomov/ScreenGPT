<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_dark_base" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ScreenGPT" android:textColor="@color/text_primary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Double-press power. Capture. Share with ChatGPT."
            android:textColor="@color/text_primary" android:textSize="18sp" />
        <TextView android:id="@+id/tvServiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:textColor="@color/brand_emerald" android:textSize="16sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="One-time screenshot access" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Enable ‘ScreenGPT screen capture’ in Accessibility. It captures only when you trigger ScreenGPT, saves the image, copies it to the clipboard, and shares it with ChatGPT. No floating window or continuous screen recording. Protected screens cannot be captured. Requires Android 11 or newer."
            android:textColor="@color/text_secondary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEnableCapture"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enable screenshot access" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="In Honor’s double-press power settings, select ScreenGPT. Use it while unlocked. You can close this settings screen. Long-press the app icon → Settings to return. Disable the old ScreenGPT volume shortcut if still enabled."
            android:textColor="@color/text_secondary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="If Honor stops the service, allow ScreenGPT to run in the background in Battery / App launch settings. Android may require you to allow restricted settings in ScreenGPT’s App info before enabling accessibility for a downloaded APK."
            android:textColor="@color/text_secondary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBatterySettings"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open battery settings" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:text="Other capture options" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Temporary screen sharing uses a persistent notification and continues after closing Settings. Android requires consent again when the session ends, including after locking on recent Android versions. This option is not needed with screenshot accessibility enabled."
            android:textColor="@color/text_secondary" android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnTemporarySession"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Start temporary capture session" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStopSession"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Stop temporary session" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSetAssistant"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Optional: set as digital assistant" />
    </LinearLayout>
</ScrollView>
